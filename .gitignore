# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!env.example

# vercel
.vercel

# local MCP server config (contains Supabase service_role key)
.mcp.json

# typescript
*.tsbuildinfo

# local IDE / CLI state
.cursor/
supabase/.temp/

# ad-hoc debug/deploy scratch files (do not commit — use scripts/ for real tooling)
/.deploy-*.json
/.mcp-*.json
/.payload-*.json
/deploy-*.json
/mcp-*.json
/built-payload.json
/tmp-*.json
/tmp-*.txt
/*.tmp.sql
